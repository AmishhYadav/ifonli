# IfOnli environment variables. Copy to .env.local for local development:
#   cp .env.example .env.local
# Never commit real secrets. Production values live in Vercel env settings.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Pooled connection (transaction pooler in production). Local Supabase default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct (non-pooled) connection, used by drizzle-kit migrations. Falls back to DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Site and auth (Better Auth)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Generate with: openssl rand -hex 32  (required in production, at least 32 characters; changing it
# locks every admin out of two-factor, see docs/RUNBOOK.md section 4)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Storage). Local values come from `supabase status`.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# ---------------------------------------------------------------------------
# Razorpay (use TEST keys until live KYC is approved)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret is a DIFFERENT secret from the key secret.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Optional boot: leave all three Razorpay values empty and the site still starts (orders stay closed
# by the launch gate). If you set one, set all three.
# Server-only. Exactly "1" lets a production deploy take orders on rzp_test_ keys (public demo before
# live KYC): the launch checklist shows a warning instead of a blocker. Remove it when going live.
PAYMENTS_TEST_MODE=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Example: IfOnli <orders@your-domain.example>
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Internal secrets (each: openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Authorises Vercel Cron requests to /api/cron/* (required in production, at least 32 characters)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Observability and analytics
# ---------------------------------------------------------------------------
SENTRY_DSN=
# Optional. GA4 loads only after consent, and only if set.
NEXT_PUBLIC_GA4_ID=
# Content-Security-Policy mode, read at BUILD time: report-only (default) or enforce. See docs/RUNBOOK.md section 9.
CSP_MODE=

# ---------------------------------------------------------------------------
# Seed and tests
# ---------------------------------------------------------------------------
# Email of the owner admin user created by `pnpm db:seed`. Required (no default) when the database is not local.
SEED_OWNER_EMAIL=owner@ifonli.local
# Password for scripts/create-admin.ts (at least 12 characters). Omit it and the script generates one and
# prints it once. Local use only: never set it in Vercel.
ADMIN_PASSWORD=
# Test/review builds only: exposes /styleguide, /dev/*, the e-mail preview and unpublished policies, and
# switches the order gate off. It is read at BUILD time. MUST stay unset in production.
NEXT_PUBLIC_ENABLE_DEV_PAGES=
# Optional: Postgres URL used by `pnpm test:integration` to (re)create the `ifonli_test` database.
# Defaults to DIRECT_URL / DATABASE_URL with the database name swapped.
# TEST_ADMIN_DATABASE_URL=
